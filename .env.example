# Copy to .env.local and fill in the values you need.

# AI: enables Anthropic-backed suggestions. Without this, /api/ai/suggest returns
# a deterministic rule-based mock.
ANTHROPIC_API_KEY=

# Strava OAuth (defer until iteration 4)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/callback

# Weather (defer until production)
OPENWEATHER_API_KEY=
